# Port, auf dem die Express-API hört
PORT=3001

# Pfad zur SQLite-Datenbankdatei (relativ zum Backend-Root oder absolut)
DB_PATH=./data/getraenke.db

# Log-Level für pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node-Environment
NODE_ENV=development

# JWT — mindestens 32 Zeichen, zufällig generiert (z. B. openssl rand -base64 48)
# Niemals diesen Wert in die Versionskontrolle einchecken!
JWT_SECRET=replace-me-with-at-least-32-random-characters-generated-by-openssl
JWT_EXPIRES_IN=8h

# Verzeichnis für Profilbilder (wird beim Start angelegt, falls nicht vorhanden)
AVATAR_DIR=./data/avatars

# Verzeichnis für den Auto-Update-Rückkanal (M14): update-status.json (vom
# Pi-Helper geschrieben) und update-requested (Marker-Datei, von dieser App
# geschrieben). Muss auf dem Pi mit /var/lib/getraenke übereinstimmen.
UPDATE_STATE_DIR=./data

# Anzahl vertrauenswürdiger Reverse-Proxy-Hops (Express "trust proxy").
# 0 = kein Proxy (Default, sicher). Hinter Caddy/nginx auf 1 setzen, damit das
# Login-Rate-Limiting die echte Client-IP statt der Proxy-IP sieht.
# NICHT auf > 0 setzen, wenn KEIN Proxy davorsteht (X-Forwarded-For wäre spoofbar).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# M15 — Automatischer Mailversand der Monatsabrechnungen (siehe docs/MAIL.md)
# ---------------------------------------------------------------------------

# Master-Schalter. Ohne MAIL_ENABLED=true passiert nichts, auch wenn die
# übrigen Werte unten gesetzt sind. Erst nach erfolgreichem Testmail aktivieren.
MAIL_ENABLED=false

# SMTP-Postausgang. Default passt zu df.eu (sslout.df.eu:465, implizites TLS).
# Bei STARTTLS auf Port 587 stattdessen SMTP_SECURE=false setzen.
SMTP_HOST=sslout.df.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bierwart-app@nassovia.de
# Niemals diesen Wert in die Versionskontrolle einchecken! Nur in
# /etc/getraenke/env auf dem Pi setzen (siehe docs/DEPLOYMENT.md).
SMTP_PASS=

# Absenderadresse (Envelope-From).
MAIL_FROM="Hängt! – Nassovia <bierwart-app@nassovia.de>"

# Empfänger der Sammelabrechnung (alle Mitglieder + alle Zeiger des Monats).
# MAIL_SUMMARY_CC ist optional, mehrere Adressen kommagetrennt.
MAIL_SUMMARY_TO=
MAIL_SUMMARY_CC=

# Zweiter Schalter für den automatischen Versand am 1. des Monats. Getrennt
# von MAIL_ENABLED, damit ein manueller Test möglich ist, bevor der
# automatische Versand scharfgeschaltet wird.
MAIL_SCHEDULE_ENABLED=false
# Stunde (0–23, Europe/Berlin), ab der am 1. des Monats versendet wird.
MAIL_SCHEDULE_HOUR=3
